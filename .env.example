# ---- Provider selection ----
# LLM_PROVIDER: ollama | openai | gemini | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2 # or gemini-2.5-flash 

JUDGE_PROVIDER=
JUDGE_MODEL=

# ---- API Keys (only needed for the chosen provider) ----
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTRHOPIC_API_KEY=

# ---- Paths ----
DATA_DIR=data

# ---- Logging ----
ENABLE_LOGGING=true
LOG_TO_FILE=true
LOG_LEVEL=INFO

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434

# ---- LLM Settings ----
REQUEST_TIMEOUT_S=300.0
CONTEXT_WINDOW=8000
TEMPERATURE=0.2
MEMORY_TOKEN_LIMIT=4096

# ---- Embeddings ----
# EMBEDDING_PROVIDER: huggingface | ollama
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=2048

# ---- Retrieval ----
RETRIEVAL_TOP_K=5

# ---- ChromaDB ----
DISTANCE_METRIC=cosine

# ---- Generic Settings ----
SEED=42

# What subdirectory of data to store files to: dev | test | prod
ENVIRONMENT=dev 

# ---- Load Settings ----
COLLECTION_NAME=documents