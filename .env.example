# Copy to .env and fill in. Unset values use the defaults shown.
# Don't put comments on the same line as a value; some dotenv parsers keep them.

# ---- General ----
# Which data/ subdirectory to use: dev | test | prod
ENVIRONMENT=dev
# Ingest new files from data/raw/<collection>/ on startup.
AUTO_INGEST=true
# When ingesting (startup or `ingest`), re-embed files whose content changed since they were ingested.
# false = only log changed files; run `ingest -c <name> --reindex` to pick them up.
REINDEX_CHANGED_FILES=true
SEED=42
DATA_DIR=data

# ---- Logging ----
ENABLE_LOGGING=true
LOG_TO_FILE=true
LOG_LEVEL=INFO

# ---- API keys (only needed for the providers you select) ----
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# ---- Ollama (shared by every role that uses provider=ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
REQUEST_TIMEOUT_S=300.0

# ---- Primary LLM (the agent) ----
# LLM_PROVIDER: ollama | openai | gemini | anthropic
LLM_PROVIDER=ollama
# e.g. qwen3 (ollama), gpt-4o-mini (openai), gemini-2.5-flash (gemini), claude-haiku-4-5 (anthropic)
LLM_MODEL=qwen3
LLM_TEMPERATURE=0.2
# Ollama only. KV-cache memory grows with context length.
LLM_CONTEXT_WINDOW=8192
# Max tokens generated per response. 0 = provider default.
LLM_MAX_TOKENS=0
# Requests per minute. 0 = unlimited.
LLM_RATE_LIMIT_RPM=0
# Ollama reasoning models (qwen3, deepseek-r1, ...): true/false turns thinking on/off; unset = model default.
# Off is faster and keeps <think> text out of answers; on can improve multi-step reasoning.
LLM_THINKING=

# ---- Router LLM (optional query classifier) ----
# Any ROUTER_* value left unset falls back to the matching LLM_* value.
# A small, fast model works well here.
ENABLE_ROUTER=false
ROUTER_PROVIDER=
ROUTER_MODEL=
ROUTER_TEMPERATURE=0.0
ROUTER_THINKING=false
# Below this confidence the router uses its default route.
ROUTER_MIN_CONFIDENCE=0.5

# ---- Judge LLM (evaluation; disabled unless JUDGE_MODEL is set) ----
# Any JUDGE_* value left unset falls back to the matching LLM_* value.
# Prefer a different model from the primary so it isn't grading itself.
JUDGE_PROVIDER=
JUDGE_MODEL=
# Set to 15 for the Gemini free tier.
JUDGE_RATE_LIMIT_RPM=0

# ---- Embeddings ----
# EMBEDDING_PROVIDER: huggingface | ollama
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Tokens per chunk. Keep at or below the embedding model's max input (512 for bge-small).
CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBED_BATCH_SIZE=32
# Requires a CUDA-enabled PyTorch build; falls back to CPU if unavailable.
USE_CUDA=false

# ---- Collections & retrieval ----
# Comma-separated; the first is the default. Each collection ingests files from data/raw/<name>/
# and can also receive documents at runtime. Per-collection overrides (NAME upper-cased,
# non-alphanumerics as _):
#   COLLECTION_<NAME>_RAW_DIR=path/relative/to/project
#   COLLECTION_<NAME>_TOP_K=8
#   COLLECTION_<NAME>_DESCRIPTION=What this collection contains (the agent reads this to choose a search tool)
COLLECTIONS=documents
RETRIEVAL_TOP_K=5
# cosine | l2 | ip. Applies when a collection is first created.
DISTANCE_METRIC=cosine

# ---- Agent & memory ----
MAX_ITERATIONS=3
MEMORY_TOKEN_LIMIT=4096
ENABLE_FACT_EXTRACTION=true
MAX_FACTS=50

# ---- Evaluation ----
# Parallel judge calls. For Ollama, match OLLAMA_NUM_PARALLEL.
EVAL_CONCURRENCY=1
